rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ---------------------------------------------------------
    // FUNCIONES GLOBALES REUTILIZABLES
    // ---------------------------------------------------------
    
    // Verifica si el usuario está autenticado en la aplicación
    function estaAutenticado() {
      return request.auth != null;
    }

    // Obtiene el rol del usuario actual desde su documento en la colección 'usuarios'
    // Se usa 'get' para leer de forma segura. Si no existe, asume 'ninguno'.
    function getRol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rolEnElSistema;
    }

    // Verifica si el usuario actual tiene rol de Administrador
    function esAdmin() {
      return estaAutenticado() && (
        (('email' in request.auth.token) && request.auth.token.email == 'admin@tutorias-jic.com') 
        || getRol() == 'admin' || getRol() == 'RolSistema.admin'
      );
    }

    // Verifica si el usuario actual tiene rol de Tutor
    function esTutor() {
      return estaAutenticado() && (getRol() == 'tutor' || getRol() == 'RolSistema.tutor');
    }
    
    // Verifica si el usuario actual tiene rol de Estudiante
    function esEstudiante() {
      return estaAutenticado() && (getRol() == 'estudiante' || getRol() == 'RolSistema.estudiante');
    }

    // ---------------------------------------------------------
    // REGLAS POR COLECCIÓN
    // ---------------------------------------------------------

    // 1. Colección de USUARIOS
    match /usuarios/{userId} {
      // Cualquiera autenticado puede leer perfiles (para ver la lista de tutores, por ejemplo)
      allow read: if estaAutenticado();
      
      // Creación: Permitida si el usuario está autenticado y coincide su UID (limitando rol a estudiante), o si es Administrador
      allow create: if estaAutenticado() && (
        (request.auth.uid == userId && (request.resource.data.rolEnElSistema == 'estudiante' || request.resource.data.rolEnElSistema == 'RolSistema.estudiante')) || 
        esAdmin()
      );
      
      // Actualización: Solo el dueño de la cuenta puede editar su perfil.
      // SEGURO APLICADO: Bloqueo de escalamiento de privilegios para campos sensibles.
      allow update: if esAdmin() || (
        estaAutenticado() && request.auth.uid == userId
        && request.resource.data.rolEnElSistema == resource.data.rolEnElSistema
        && request.resource.data.esta_baneado == resource.data.esta_baneado
        && request.resource.data.strikes_inasistencia == resource.data.strikes_inasistencia
      ) || (
        esTutor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['strikes_inasistencia'])
      ) // Permitimos a los tutores asignar strikes en la asistencia
      || (
        estaAutenticado() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puntos_vecta', 'insignias_tutor'])
      ); // Permitimos a los alumnos dar puntos e insignias de gamificación al evaluar
      
      // Eliminación: Solo un Administrador puede borrar cuentas, o el dueño (si decides permitirlo)
      allow delete: if esAdmin() || (estaAutenticado() && request.auth.uid == userId);
      
      // Subcolección EVALUACIONES anidada
      match /evaluaciones/{evaluacionId} {
        allow read: if estaAutenticado();
        // Solo estudiantes pueden calificar y el admin puede moderar
        allow create: if estaAutenticado(); 
        allow update, delete: if esAdmin();
      }

      // Subcolección EXPEDIENTE ACADÉMICO anidada
      match /expediente_academico/{expedienteId} {
        allow read: if estaAutenticado() && (request.auth.uid == userId || esAdmin() || esTutor());
        allow create: if esTutor() || esAdmin();
        allow update, delete: if esAdmin();
      }
    }

    // 2. Colección de TUTORÍAS
    match /tutorias/{tutoriaId} {
      // Cualquier usuario autenticado puede ver las tutorías disponibles
      allow read: if estaAutenticado();
      
      // Estudiantes pueden sugerir, Tutores pueden crear, Admins pueden crear
      allow create: if estaAutenticado(); 
      
      // Actualización: BLINDADA
      // Se protege que estudiantes no puedan cambiar a los tutores ni a los autores
      allow update: if esAdmin() || (
        estaAutenticado() && (
          // El tutor aceptando o modificando
          (request.auth.uid == resource.data.identificadorDelTutor || request.auth.uid == request.resource.data.identificadorDelTutor)
          ||
          // O un estudiante inscribiéndose (dejamos que modifique, pero protegiendo al dueño)
          (request.resource.data.identificadorDeTutoria == resource.data.identificadorDeTutoria
           && request.resource.data.identificadorDelTutor == resource.data.identificadorDelTutor)
        )
      );
      
      // Eliminación: Solo el admin, o el tutor/estudiante que la creó (para cancelarla)
      // Se valida que el uid del creador o del tutor coincida, o sea admin
      allow delete: if esAdmin() || 
                    (estaAutenticado() && (resource.data.creador == request.auth.uid || resource.data.identificadorDelTutor == request.auth.uid));

      // Subcolección CHAT anidada
      match /chat/{mensajeId} {
        // Cualquier usuario autenticado puede leer y escribir mensajes en el chat
        allow read, create: if estaAutenticado();
        
        // Solo el autor original del mensaje o un Administrador pueden borrar el mensaje
        allow delete: if estaAutenticado() && (request.auth.uid == resource.data.emisorId || esAdmin());
      }
    }

    // 3. Colección de NOTIFICACIONES (Bloqueada al UID del usuario o Admin)
    match /notificaciones/{notificacionId} {
      // Lectura y borrado permitidos al admin y al dueño de la notificación
      allow read, update, delete: if esAdmin() || (estaAutenticado() && resource.data.usuarioId == request.auth.uid);
      
      // Cualquier usuario autenticado puede generar una notificación (Ej: Un estudiante le envía a un tutor)
      allow create: if estaAutenticado();
    }



    // Regla global para el collectionGroup de 'evaluaciones'
    match /{path=**}/evaluaciones/{evaluacionId} {
      allow read: if esAdmin();
    }

    // 5. QUEJAS Y TRIBUNAL (Privacidad Estricta)
    match /quejas/{quejaId} {
      // Estudiantes o tutores pueden crear una queja
      allow create: if estaAutenticado();
      // SOLO el Administrador puede leer, actualizar o borrar quejas
      allow read, update, delete: if esAdmin();
    }

    match /reportes_tribunal/{reporteId} {
      // Estudiantes o tutores pueden reportar a alguien ausente/tóxico
      allow create: if estaAutenticado();
      // SOLO el Administrador puede procesar, leer y archivar el tribunal
      allow read, update, delete: if esAdmin();
    }

  }
}
